# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Anthropic Claude) ────────────────────────────────
# Used by api/search.js, api/recommend.js, api/chat.js, api/upload/[type].js
ANTHROPIC_API_KEY=

# ── Payments (PayMongo) ──────────────────────────────────
# Secret key (sk_test_… while integrating, sk_live_… in prod) — api/payments.js
PAYMONGO_SECRET_KEY=
# Webhook signing secret from the PayMongo dashboard — api/webhooks/paymongo.js
PAYMONGO_WEBHOOK_SECRET=

# ── Email (Brevo SMTP) ───────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Costarax <hello@costarax.com>

# ── App URLs ─────────────────────────────────────────────
APP_URL=https://costarax.com
NEXT_PUBLIC_APP_URL=https://costarax.com
